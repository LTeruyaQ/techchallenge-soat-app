      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "api_version": "apps/v1",
            "apply_only": false,
            "force_conflicts": false,
            "force_new": false,
            "id": "/apis/apps/v1/namespaces/observability/deployments/otel-collector",
            "ignore_fields": null,
            "kind": "Deployment",
            "live_manifest_incluster": "e271d126081b2ac0e630c13982c368192b617d7e8e6ece478ff84dddec9e7b7a",
            "live_uid": "0edf7e60-cc38-4586-aec2-9c8fc3b1b0fb",
            "name": "otel-collector",
            "namespace": "observability",
            "override_namespace": null,
            "sensitive_fields": null,
            "server_side_apply": false,
            "timeouts": null,
            "uid": "0edf7e60-cc38-4586-aec2-9c8fc3b1b0fb",
            "validate_schema": true,
            "wait": null,
            "wait_for_rollout": true,
            "yaml_body": "apiVersion: apps/v1\r\nkind: Deployment\r\nmetadata:\r\n  name: otel-collector\r\n  namespace: observability\r\n  labels:\r\n    app: otel-collector\r\nspec:\r\n  replicas: 1\r\n  selector:\r\n    matchLabels:\r\n      app: otel-collector\r\n  template:\r\n    metadata:\r\n      labels:\r\n        app: otel-collector\r\n    spec:\r\n      containers:\r\n        - name: otel-collector\r\n          image: otel/opentelemetry-collector-contrib:0.114.0\r\n          args:\r\n            - --config=/etc/otel-collector-config.yaml\r\n          ports:\r\n            - containerPort: 4317\r\n              name: otlp-grpc\r\n              protocol: TCP\r\n            - containerPort: 4318\r\n              name: otlp-http\r\n              protocol: TCP\r\n            - containerPort: 13133\r\n              name: health\r\n              protocol: TCP\r\n          env:\r\n            - name: DD_API_KEY\r\n              valueFrom:\r\n                secretKeyRef:\r\n                  name: otel-collector-secret\r\n                  key: DD_API_KEY\r\n            - name: NR_LICENSE_KEY\r\n              valueFrom:\r\n                secretKeyRef:\r\n                  name: otel-collector-secret\r\n                  key: NR_LICENSE_KEY\r\n          volumeMounts:\r\n            - name: otel-collector-config\r\n              mountPath: /etc/otel-collector-config.yaml\r\n              subPath: otel-collector-config.yaml\r\n              readOnly: true\r\n          resources:\r\n            requests:\r\n              cpu: 100m\r\n              memory: 256Mi\r\n            limits:\r\n              cpu: 500m\r\n              memory: 512Mi\r\n          livenessProbe:\r\n            httpGet:\r\n              path: /\r\n              port: health\r\n            initialDelaySeconds: 10\r\n            periodSeconds: 10\r\n          readinessProbe:\r\n            httpGet:\r\n              path: /\r\n              port: health\r\n            initialDelaySeconds: 5\r\n            periodSeconds: 5\r\n      volumes:\r\n        - name: otel-collector-config\r\n          configMap:\r\n            name: otel-collector-config\r\n",
            "yaml_body_parsed": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  labels:\n    app: otel-collector\n  name: otel-collector\n  namespace: observability\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: otel-collector\n  template:\n    metadata:\n      labels:\n        app: otel-collector\n    spec:\n      containers:\n      - args:\n        - --config=/etc/otel-collector-config.yaml\n        env:\n        - name: DD_API_KEY\n          valueFrom:\n            secretKeyRef:\n              key: DD_API_KEY\n              name: otel-collector-secret\n        - name: NR_LICENSE_KEY\n          valueFrom:\n            secretKeyRef:\n              key: NR_LICENSE_KEY\n              name: otel-collector-secret\n        image: otel/opentelemetry-collector-contrib:0.114.0\n        livenessProbe:\n          httpGet:\n            path: /\n            port: health\n          initialDelaySeconds: 10\n          periodSeconds: 10\n        name: otel-collector\n        ports:\n        - containerPort: 4317\n          name: otlp-grpc\n          protocol: TCP\n        - containerPort: 4318\n          name: otlp-http\n          protocol: TCP\n        - containerPort: 13133\n          name: health\n          protocol: TCP\n        readinessProbe:\n          httpGet:\n            path: /\n            port: health\n          initialDelaySeconds: 5\n          periodSeconds: 5\n        resources:\n          limits:\n            cpu: 500m\n            memory: 512Mi\n          requests:\n            cpu: 100m\n            memory: 256Mi\n        volumeMounts:\n        - mountPath: /etc/otel-collector-config.yaml\n          name: otel-collector-config\n          readOnly: true\n          subPath: otel-collector-config.yaml\n      volumes:\n      - configMap:\n          name: otel-collector-config\n        name: otel-collector-config\n",
            "yaml_incluster": "e271d126081b2ac0e630c13982c368192b617d7e8e6ece478ff84dddec9e7b7a"
